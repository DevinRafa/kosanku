{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/", "dest": "/api/index.php" },
    { "src": "/kos/([0-9]+)/?", "dest": "/api/detail.php?id=$1" },
    { "src": "/tambah/?", "dest": "/api/create.php" },
    { "src": "/ubah/([0-9]+)/?", "dest": "/api/edit.php?id=$1" },
    { "src": "/hapus/?", "dest": "/api/delete.php" }
  ]
}
